# dom - household app (github.com/PawelWywiol/dom)
# Copy this file to .env on the host and fill in the values; .env never goes to git.
#
# Prerequisites:
#   - docker login ghcr.io as `code` (the image is private)
#   - mailbox on the own mail server for MAIL_FROM
#   - Caddy route for dom.wywiol.eu on x000 + Cloudflare tunnel ingress

POSTGRES_USER=dom
POSTGRES_PASSWORD=
POSTGRES_DB=dom

# Public address; it is embedded in the login links sent by e-mail
APP_URL=https://dom.wywiol.eu

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=dom <dom@wywiol.eu>

# Invite list; checked on every request, removing an address revokes access
ALLOWED_EMAILS=
